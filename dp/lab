import heapq
class Activity:
    def __init__(self, start, end, name):
        self.start = start
        self.end = end
        self.name = name

    def acivity_selection(self, activities: list) -> list:
        final = []
        heapq.heapify(activities)#make a min heap so it sorts in O(n) time using the end time
        #now loop through all the activities in the heap until its empty and add to the final array as lone as not overlapping, using the start and end times
        last_end = float('-inf')
        while activities:
            end,start,name = heapq.heappop(activities)
            if start >= last_end:
                last_end = end
                final.append((name, start, end))
        return final

